APP_ENV=development
DATABASE_URL=postgresql://faqrag:faqrag@db:5432/faqrag
POSTGRES_DB=faqrag
POSTGRES_USER=faqrag
# Local-only default. Set a unique URL-safe password before deploying.
POSTGRES_PASSWORD=faqrag
EMBEDDING_MODEL=BAAI/bge-m3
# Resolved from the selected model at startup; override only for controlled local testing.
EMBEDDING_DIM=
RETRIEVAL_VECTOR_THRESHOLD=0.5
RETRIEVAL_KEYWORD_THRESHOLD=0.1
RETRIEVAL_MIN_TERM_COVERAGE=0.65
ANTHROPIC_API_KEY=
# Set this to a Claude model available to your Anthropic account.
CLAUDE_MODEL=
LLM_PROVIDER=anthropic
# Used only when LLM_PROVIDER=gemini. Verify model access and current quotas for your key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
CLAUDE_MAX_TOKENS=700
CLAUDE_TIMEOUT_SECONDS=30
CLAUDE_MAX_RETRIES=2
ADMIN_TOKEN=
CORS_ALLOW_ORIGINS=
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
MAX_REQUEST_BYTES=65536
SUPPORT_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_TIMEOUT_SECONDS=10
OUTBOX_PATH=data/outbox/messages.jsonl
